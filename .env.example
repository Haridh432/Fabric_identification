# ==============================================================
# FABRIC IDENTIFICATION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================

# Firebase Realtime Database Configuration
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id

# Firebase Admin SDK Credentials Path (for Python ML Backend)
# Download this from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# ML Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# ML Model Paths
MODEL_DIR=../ml/models
MODEL_FILE=fabric_svm.pkl
SCALER_FILE=scaler.pkl
WAVELENGTHS_FILE=wavelengths.json
METADATA_FILE=model_metadata.json

# ESP32 Settings (for reference)
ESP32_WIFI_SSID=Your_WiFi_SSID
ESP32_WIFI_PASSWORD=Your_WiFi_Password
ESP32_FIREBASE_HOST=your-project-id-default-rtdb.firebaseio.com
ESP32_FIREBASE_AUTH=your_database_secret_or_token
